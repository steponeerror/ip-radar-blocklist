# ip-radar 黑名单每日导出(生成 + 推送)systemd 单元。
# 安装:cp deploy/ipradar-blocklist.{service,timer} /etc/systemd/system/
#       systemctl daemon-reload && systemctl enable --now ipradar-blocklist.timer
# 手工触发一轮:systemctl start ipradar-blocklist.service
# 日志:journalctl -u ipradar-blocklist.service(manifest JSON 走 stdout)

[Unit]
Description=ip-radar nightly blocklist export (generate in container, push from host)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/ip-radar-blocklist

# 整轮实测 ~2.5h(run#3 8762s;idle 优先级 + 与生产引擎抢资源会更慢)。
# 4h 是守门上限(真卡死由下一轮 timer + 容器自身 RSS 红线兜底),非预期运行时长;
# 实测 2h 上限曾把正常轮次拦腰杀掉(2026-10-04 06:30 timeout → push 未执行)。
TimeoutStartSec=4h

# 生成:一次性容器(跑完 --rm 自删;restart: "no" 见 compose 注释)。
# ExecStart 非零退出(管线失败)→ 本单元 failed,ExecStartPost 不执行 ——
# 失败轮绝不推送,错误态只留在容器外的 manifest.json 里。
ExecStart=/usr/bin/docker compose -f /opt/ip-radar-blocklist/deploy/docker-compose.exporter.yml --profile export run --rm blocklist-exporter

# 推送:仅在生成成功后于宿主机执行(PAT 只在宿主机,永不进容器)。
# RELEASE_DATE 覆盖为北京日期:push.sh 默认 UTC 日期,而 21:00 UTC 起跑的轮次
# 在 UTC 仍属前一日,不覆盖会让北京早间发布的 tag 恒晚一天。
# (%%F 的双 % 是 systemd 单元文件对字面 % 的转义。)
ExecStartPost=/bin/sh -c 'RELEASE_DATE=$(TZ=Asia/Shanghai date +%%F) /opt/ip-radar-blocklist/deploy/push.sh'

# 发推:Release 成功后紧跟(当天已发过则 tweet.py 自身 state 防重跳过)。
# 失败语义:重试一次后 exit 1 → 本单元 failed(journal 可见),不影响已发布的 Release。
ExecStartPost=/usr/bin/python3 /opt/ip-radar-blocklist/deploy/tweet.py

# 夜间批活,压到最低优先级,不与引擎抢 CPU/IO
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
