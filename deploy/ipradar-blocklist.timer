# 每日 UTC 21:00 触发(北京 05:00 起跑):预算 4h(=TimeoutStartSec 硬顶)
# 兑现“北京 9 点可查”死线——#444 起一轮约 1.7–2 小时(2026-11-25 生产两次试跑:
# 第二次整轮 102.6 分钟,第一次扫描一段就 113.7 分钟),约 07:00 前发布;跑的时段
# (服务器时间 22:00 起)前后相邻的健康轮是 20:00 和 04:00,都不撞。
# 2026-11-17 曾在服务器上本地改成 19:00 UTC + 6h 预算(旧办法一轮要 3 小时 47 分,
# 4h 连杀两晚),没有提交;#444 之后一轮 1.7–2 小时,2026-11-25 回到本文件。
# 安装与启用见 deploy/ipradar-blocklist.service 头注。

[Unit]
Description=Nightly trigger for ipradar-blocklist export

[Timer]
# UTC 后缀免疫宿主冬令时切换(CEST↔CET 漂移 1h)。
# 摄取为滚动节奏(各源独立周期全天分布,2026-10-05 日志实证),
# 无集中完成点可对齐,任意起跑时刻数据等效新鲜。
OnCalendar=*-*-* 21:00:00 UTC
# 停机跨过触发点 → 开机补跑一轮,不空窗
Persistent=true
Unit=ipradar-blocklist.service

[Install]
WantedBy=timers.target
